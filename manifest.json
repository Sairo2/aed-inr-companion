{
  "manifest_version": 3,
  "name": "AED → INR Companion",
  "version": "1.0.0",
  "description": "Shows an INR estimate next to AED prices on web pages.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://open.er-api.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["converter.js", "content.js"],
      "css": ["injected.css"],
      "run_at": "document_idle"
    }
  ]
}
